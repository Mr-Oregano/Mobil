let math = {  
  add: \(a: num) -> \(b: num) -> a + b,
  dbl: \(c: num) -> c + c,
  fst: \(r: { a: num, b: num }) -> r.a,
  snd: \(r: { a: num, b: num }) -> r.b
} in

let _ = math.add 8 r2.a in
let _ = math.dbl 8 in
let _ = math.fst r1 in
let _ = math.snd r1 in

let baz = \(lib: { fst: ({ a: num, b: num, c: num }) -> num }) -> lib.fst { a: 69, b: 420, c: 42 } in
let _ = baz math in

