
################### CLIENT ###################

# Client program wants to do heavy processing on a large amount of data
# and retrieve filtered results for further, local processing

mark M_ProcessData in

let Arrays = () in # <--- Client's local instance to built-in module
let db = () in     # <--- Client may have local instance to db
let Mkit = () in   # <--- Client may have local instance to math library

# Marshal code using the resources that will be dynamically rebound
let package = (marshal M_ProcessData
    (\(u: unit) -> let records = db.query () in
     let cov = Mkit.cov (Mkit.transpose (records - Mkit.mean records)) in
     let eigvecs = (Mkit.eig cov) in
     let transformed = Arrays.firstn 2 (Mkit.dot records eigvecs) in
     Mkit.kmeans2 4 transformed)) in

# The underlying mechanism that marshals the code into a package will
# first elevate it into a function requesting dynamic rebinds as 
# parameters? This function will be serialized as an AST to be interpreted 
# on the opposing end. 
# 
# More sophisticated implementations may use an IR after optimizations.

# Send the marshalled code through a request channel
let _ = request_chan ! package in

# Block and wait for results through receive channel
let clusters = receive_chan ? in

# ...
()
