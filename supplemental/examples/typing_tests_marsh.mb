
let foo1 = \(c: chan num) ->
    let p = marshal 9 in
    c ! p
in

let print = \(n: num) -> () in

let test = marshal \(n: num) -> 
    let _ = print n in
    n
in

let foo2 = \(c: chan [ print: num -> unit ] num) ->
    # Marshaling and sending...
    let p = marshal ((unmarshal [ print: print ] test) 9) in
    let _ = c ! p in

    # Receiving and unmarshaling...
    let p_recv = c ? in
    let n = unmarshal [ print: print ] p_recv in
    ()
in

()