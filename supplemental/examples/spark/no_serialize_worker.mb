
let worker_main = \(recv: chan { data: num, map: num -> num }) -> \(send: chan num) ->
    # Receive a package from the request channel, a real implementation
    # might just receive a partition of the work to actually execute and 
    # instructions on what to do.
    let pkg = recv ? in
    # let pkg = unmarshal [ this: { offset: 5 } ] recv ? in

    # Compute the value
    # <<< COMPILE ERROR HAPPENS HERE >>>
    let result = pkg.map pkg.data in

    # Send the value back to the driver
    send ! (marshal result)
in

let driver_main = \(send: chan { data: num, map: num -> num }) -> \(recv: chan num) ->
    # class UnserializablePipeline {
    let run = \(this: { offset: num }) ->
        let number = 5 in
        
        # Create the package that will be sent to worker nodes
        let pkg = marshal 
        { 
            data: number,
            map: \(x: num) -> x + this.offset
        }    
        in

        # Send through channel
        let _ = send ! pkg in

        # Receive result from channel
        unmarshal (recv ?)
    in
    # }

    # App {

    # Initialize the pipeline object
    let unserializable = { offset: 10 } in

    # Execute the pipeline
    run unserializable
    # }
in

# Create communication channels, Spark handles communication automatically
# This is an extremely simplified example in a simplified language
if true then
    # Worker (Server)
    let recv = listen { data: num, map: num -> num } 8080 in
    let send = listen num 8081 in
    worker_main recv send
else
    # Driver (Client)
    let send = connect { data: num, map: num -> num } "localhost" 8080 in
    let recv = connect num "localhost" 8081 in
    driver_main send recv